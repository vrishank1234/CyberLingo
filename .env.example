# Firebase Configuration
VITE_FIREBASE_API_KEY=mock-api-key
VITE_FIREBASE_AUTH_DOMAIN=cyberlingo-app.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=cyberlingo-app
VITE_FIREBASE_STORAGE_BUCKET=cyberlingo-app.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=123456789012
VITE_FIREBASE_APP_ID=1:123456789012:web:abcdef1234567890

# Firebase Emulator toggle (set to true to connect to local emulator suite)
VITE_USE_FIREBASE_EMULATOR=false
VITE_EMULATOR_HOST=localhost
